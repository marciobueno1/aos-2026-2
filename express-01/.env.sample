JWT_SECRET=<gere-com-openssl-rand-base64-48>
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<SERVER>/<DATABASE_NAME>?sslmode=verify-full&channel_binding=require
PORT=4001
SYNC_DATABASE=false
ERASE_DATABASE_ON_SYNC=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Senhas iniciais do seeder (opcionais). Se ficarem comentadas, o seeder gera
# senhas aleatórias e as exibe no console apenas com NODE_ENV=development.
# NUNCA use valores de exemplo aqui: este arquivo é público no GitHub.
# ADMIN_PASSWORD=
# USER_PASSWORD=
